# Habilita a chamada do frontend ao endpoint autenticado e same-origin.
VITE_AI_SUMMARY_ENABLED=false

# Integracao opcional, exclusivamente server-side. Nunca use prefixo VITE_.
AI_SUMMARY_ENDPOINT=https://provider.example.com/v1/responses
AI_SUMMARY_API_KEY=replace_with_server_side_secret

# Supabase - frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Supabase - server
# Use apenas no backend. Nao exponha no browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
