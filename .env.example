# Endpoint opcional para resumo inteligente.
# Recomendacao: usar um endpoint seu no backend ou serverless.
VITE_AI_SUMMARY_ENDPOINT=https://your-domain.com/api/ai-summary

# Opcional. Use apenas se o endpoint aceitar chave no frontend.
# Para OpenAI, prefira guardar a chave no backend.
VITE_AI_SUMMARY_API_KEY=

# Supabase - frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Supabase - server
# Use apenas no backend. Nao exponha no browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_secret_key
